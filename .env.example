# Copy to .env. The server reads these; nothing here reaches the browser.

# Data source for development: carserver via SSH tunnel
#   ssh -N -L 18123:localhost:8123 jan@192.168.42.207
CLICKHOUSE_URL=http://localhost:18123
CLICKHOUSE_USER=letsview
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sdlog

# Test database (docker compose up -d)
TEST_CLICKHOUSE_URL=http://localhost:8124
TEST_CLICKHOUSE_USER=letsview
TEST_CLICKHOUSE_PASSWORD=letsview

# Optional (defaults shown)
# LETSVIEW_HOST=127.0.0.1
# LETSVIEW_PORT=8080
# LETSVIEW_TABLE=signals
# LETSVIEW_COLUMN_DATAREF=vehicle
# LETSVIEW_COLUMN_SIGNAL=signal
# LETSVIEW_COLUMN_TIME=utc
# LETSVIEW_COLUMN_VALUE=value
# LETSVIEW_DBC_FILES=../CarController/vehicles/smart451/dbc/h-can.dbc,../CarController/vehicles/smart451/dbc/hybrid-can.dbc
# LETSVIEW_QUERY_CONCURRENCY=4
# LETSVIEW_QUERY_TIMEOUT_S=30
