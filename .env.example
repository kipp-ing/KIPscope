# Copy to .env. The server reads these; nothing here reaches the browser.

# The server's one source: clickhouse (default) or adx; the other source's variables are ignored
# KIPSCOPE_SOURCE=clickhouse

# Data source for development: carserver via SSH tunnel
#   ssh -N -L 18123:localhost:8123 jan@192.168.42.207
CLICKHOUSE_URL=http://localhost:18123
CLICKHOUSE_USER=letsview
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sdlog

# ADX (KIPSCOPE_SOURCE=adx), signed in with your Azure CLI login (az login); no secret here
# KIPSCOPE_ADX_CLUSTER=https://<cluster>.<region>.kusto.windows.net
# KIPSCOPE_ADX_DATABASE=<database>
# KIPSCOPE_ADX_AUTH=azcli
# Kusto emulator (docker compose --profile adx up -d); auth none and http:// only for loopback
# KIPSCOPE_ADX_CLUSTER=http://127.0.0.1:8125
# KIPSCOPE_ADX_DATABASE=kipscope_test
# KIPSCOPE_ADX_AUTH=none

# Test database (docker compose up -d)
TEST_CLICKHOUSE_URL=http://localhost:8124
TEST_CLICKHOUSE_USER=kipscope
TEST_CLICKHOUSE_PASSWORD=kipscope

# Optional (defaults shown)
# KIPSCOPE_HOST=127.0.0.1
# KIPSCOPE_PORT=7310
# Signals table and columns; ClickHouse defaults, ADX defaults: dataref, signal, timestamp, value, text
# KIPSCOPE_TABLE=signals
# KIPSCOPE_COLUMN_DATAREF=vehicle
# KIPSCOPE_COLUMN_SIGNAL=signal
# KIPSCOPE_COLUMN_TIME=utc
# KIPSCOPE_COLUMN_VALUE=value
# KIPSCOPE_COLUMN_TEXT=text
# Events table (same database, data-ref and time columns as the signals table); missing table: no events
# KIPSCOPE_EVENTS_TABLE=events
# KIPSCOPE_EVENT_COLUMN_SOURCE=source
# KIPSCOPE_EVENT_COLUMN_KIND=kind
# KIPSCOPE_EVENT_COLUMN_NAME=name
# KIPSCOPE_EVENT_COLUMN_VALUE=value
# KIPSCOPE_EVENT_COLUMN_TEXT=text
# KIPSCOPE_EVENT_COLUMN_DETAIL=detail
# KIPSCOPE_DBC_FILES=../CarController/vehicles/smart451/dbc/h-can.dbc,../CarController/vehicles/smart451/dbc/hybrid-can.dbc
# KIPSCOPE_DIAG_CATALOGS=../CarController/vehicles/smart451/uds/bms-live.manifest.json
# KIPSCOPE_QUERY_CONCURRENCY=4
# KIPSCOPE_QUERY_TIMEOUT_S=30
# KIPSCOPE_PROJECT_FILE=kipscope.yaml
# Workspace state and saved views, relative to the repo root
# KIPSCOPE_STATE_DIR=.kipscope
# Signal list: full (whole catalog at start) or scoped (only the active scope's list, docs/data-sources.md "Scope")
# KIPSCOPE_CATALOG=full
# Padding on each side of a scope derived from a view (30min, 1h, 0s; at least 0)
# KIPSCOPE_SCOPE_PAD=1h

# Users and rights (docs/deploy.md). Default none: no login, the one user "local" sees all data.
# With any other identity a workspace shows only the vehicles KI.ping granted it (none at first).
# none, oidc (JWT access tokens, e.g. from Ping Identity) or module:<path> (own adapter, a path
# absolute or relative to the server's working directory, apps/server with pnpm; example:
# module:examples/forward-header.mjs, which reads KIPSCOPE_TRUSTED_PROXIES, default 127.0.0.1,::1)
# KIPSCOPE_IDENTITY=none
# Origins the browser uses, comma-separated http(s)://host[:port]; required unless none
# KIPSCOPE_ORIGINS=
# With oidc: issuer (https) and audience required; the key set is discovered unless set
# KIPSCOPE_OIDC_ISSUER=
# KIPSCOPE_OIDC_AUDIENCE=
# KIPSCOPE_OIDC_JWKS_URL=
# KIPSCOPE_OIDC_USER_CLAIM=sub
# Claim name or dotted path, e.g. realm_access.roles
# KIPSCOPE_OIDC_ROLES_CLAIM=roles
# Header with the token; authorization carries "Bearer <jwt>", any other header the bare JWT
# KIPSCOPE_OIDC_HEADER=authorization
# Subset of RS256 RS384 RS512 PS256 PS384 PS512 ES256 ES384 ES512 EdDSA
# KIPSCOPE_OIDC_ALGS=RS256,PS256,ES256
# Whether owners may share a workspace (read or write) with other users: on or off; ignored with none
# KIPSCOPE_SHARE=on
# Days after which an untouched workspace without a live client is deleted
# KIPSCOPE_WORKSPACE_IDLE_DAYS=30
# Built UI the server serves (apps/web/dist after pnpm build); unset: none
# KIPSCOPE_WEB_DIR=
