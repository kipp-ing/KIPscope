VERSION ""

NS_ :
	CM_
	VAL_

BS_:

BU_: TEST ESP

BO_ 256 Fast_100h: 8 TEST
 SG_ SIG_A : 0|16@1+ (0.1,0) [0|6553.5] "rpm"  ESP
 SG_ SIG_B : 16|16@1+ (0.1,0) [0|6553.5] "°C"  ESP
 SG_ SIG_C : 32|16@1- (1,0) [-100|100] ""  ESP
 SG_ SIG_D : 48|8@1+ (1,0) [0|255] "bar"  ESP

