# Copy to .env. The server reads these; nothing here reaches the browser.

# Data source for development: carserver via SSH tunnel
#   ssh -N -L 18123:localhost:8123 jan@192.168.42.207
CLICKHOUSE_URL=http://localhost:18123
CLICKHOUSE_USER=letsview
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sdlog

# Test database (docker compose up -d)
TEST_CLICKHOUSE_URL=http://localhost:8124
TEST_CLICKHOUSE_USER=kipscope
TEST_CLICKHOUSE_PASSWORD=kipscope

# Optional (defaults shown)
# KIPSCOPE_HOST=127.0.0.1
# KIPSCOPE_PORT=7310
# KIPSCOPE_TABLE=signals
# KIPSCOPE_COLUMN_DATAREF=vehicle
# KIPSCOPE_COLUMN_SIGNAL=signal
# KIPSCOPE_COLUMN_TIME=utc
# KIPSCOPE_COLUMN_VALUE=value
# KIPSCOPE_COLUMN_TEXT=text
# Events table (same database, data-ref and time columns as the signals table); missing table: no events
# KIPSCOPE_EVENTS_TABLE=events
# KIPSCOPE_EVENT_COLUMN_SOURCE=source
# KIPSCOPE_EVENT_COLUMN_KIND=kind
# KIPSCOPE_EVENT_COLUMN_NAME=name
# KIPSCOPE_EVENT_COLUMN_VALUE=value
# KIPSCOPE_EVENT_COLUMN_TEXT=text
# KIPSCOPE_EVENT_COLUMN_DETAIL=detail
# KIPSCOPE_DBC_FILES=../CarController/vehicles/smart451/dbc/h-can.dbc,../CarController/vehicles/smart451/dbc/hybrid-can.dbc
# KIPSCOPE_DIAG_CATALOGS=../CarController/vehicles/smart451/uds/bms-live.manifest.json
# KIPSCOPE_QUERY_CONCURRENCY=4
# KIPSCOPE_QUERY_TIMEOUT_S=30
# KIPSCOPE_PROJECT_FILE=kipscope.yaml
