CM_ "Demo DBC for the KIPscope screenshots. Every signal is one the Open Vehicle Monitoring System (OVMS v3, module vehicle_smarted) decodes publicly for the smart fortwo electric drive 451; message and signal names are made up for this demo.";
CM_ SG_ 360 ChargeActive "Charging active (OVMS xse.v.c.active)";
CM_ SG_ 512 Handbrake "Handbrake applied (OVMS v.e.handbrake)";
CM_ SG_ 512 VehSpeed "Vehicle speed (OVMS v.p.speed)";
CM_ SG_ 725 SocReal "State of charge as the BMS reports it (OVMS xse.v.b.real.soc)";
CM_ SG_ 792 Throttle "Power bar on the dashboard (OVMS v.e.throttle)";
CM_ SG_ 792 RangeEst "Range shown on the dashboard (OVMS v.b.range.est)";
CM_ SG_ 974 EnergyStart "Energy used since start (OVMS xse.v.b.energy.used.start)";
CM_ SG_ 981 Bat12V "12 V battery voltage (OVMS xse.v.b.12v.voltage)";
CM_ SG_ 983 HvActive "HV system active (OVMS xse.v.b.hv.active)";
CM_ SG_ 1032 OutsideTemp "Outside temperature (OVMS v.e.temp)";
CM_ SG_ 1042 Odometer "Odometer (OVMS v.p.odometer)";
CM_ SG_ 1048 Gear "Selected gear (OVMS v.e.gear)";
CM_ SG_ 1059 Ignition "Ignition on (OVMS v.e.on)";
CM_ SG_ 1059 DoorFL "Driver door open (OVMS v.d.fl)";
CM_ SG_ 1059 DoorFR "Passenger door open (OVMS v.d.fr)";
CM_ SG_ 1059 Tailgate "Tailgate open (OVMS v.d.trunk)";
CM_ SG_ 1059 Headlights "Headlights on (OVMS v.e.headlights)";
CM_ SG_ 1096 PackVoltage "HV pack voltage (OVMS v.b.voltage)";
CM_ SG_ 1155 AcVoltage "Charger mains voltage L1 (OVMS xse.v.nlg6.main.volts)";
CM_ SG_ 1155 AcCurrent "Charger mains current L1 (OVMS xse.v.nlg6.main.amps)";
CM_ SG_ 1155 DcVoltage "Charger DC output voltage (OVMS xse.v.nlg6.dc.hv)";
CM_ SG_ 1155 DcCurrent "Charger DC output current (OVMS xse.v.nlg6.dc.current)";
CM_ SG_ 1155 ChargerTemp "Charger temperature (OVMS xse.v.nlg6.temp.reported)";
CM_ SG_ 1284 TripStart "Trip distance since start (OVMS xse.v.display.trip.start)";
CM_ SG_ 1288 PackCurrent "HV pack current, negative while discharging (OVMS v.b.current)";
CM_ SG_ 1288 ChargePort "Charge cable plugged in (OVMS v.d.cp)";
CM_ SG_ 1304 PilotLimit "Current limit from the charging station's pilot signal (OVMS v.c.climit)";
CM_ SG_ 1304 DriveMode "Drive mode (OVMS v.e.drivemode)";
CM_ SG_ 1304 SocDisplay "State of charge shown on the dashboard (OVMS v.b.soc)";
CM_ SG_ 2031 CellV_01 "Cell voltage 1 of 93, polled (OVMS v.b.c.voltage)";
CM_ SG_ 2031 CellT_1 "Module temperature sensor 1 of 9, polled (OVMS v.b.c.temp)";
CM_ SG_ 2031 BatTemp "Battery temperature, polled (OVMS v.b.temp)";
CM_ SG_ 2031 Soh "State of health, polled (OVMS v.b.soh)";
CM_ SG_ 2031 CapAvg "Average cell capacity, polled (OVMS v.b.cac)";
CM_ SG_ 2031 Isolation "DC isolation resistance, polled (OVMS xse.mybms.isolation)";

VAL_ 360 ChargeActive 0 "OFF" 1 "CHARGING" ;
VAL_ 512 Handbrake 0 "RELEASED" 1 "APPLIED" ;
VAL_ 983 HvActive 0 "OFF" 1 "ON" ;
VAL_ 1048 Gear 0 "N" 17 "D" 187 "R" 221 "P" 255 "SNA" ;
VAL_ 1059 Ignition 0 "OFF" 1 "ON" ;
VAL_ 1059 DoorFL 0 "CLOSED" 1 "OPEN" ;
VAL_ 1059 DoorFR 0 "CLOSED" 1 "OPEN" ;
VAL_ 1059 Tailgate 0 "CLOSED" 1 "OPEN" ;
VAL_ 1059 Headlights 0 "OFF" 1 "ON" ;
VAL_ 1288 ChargePort 0 "UNPLUGGED" 1 "PLUGGED" ;
VAL_ 1304 DriveMode 32 "D-" 64 "D" 96 "D+" 128 "Ds" ;
VAL_ 1304 SocDisplay 255 "SNA" ;

